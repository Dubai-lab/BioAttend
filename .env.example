# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Client-safe (VITE_ prefix = bundled into the browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- SERVER ONLY. Never prefix with VITE_. ---
# Vite inlines every VITE_* variable into the public JS bundle.
# Prefixing this key would publish full database access to the internet.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
